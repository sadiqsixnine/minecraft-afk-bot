# Copy these into Render → Service → Environment (or use render.yaml).
# Every value is optional: settings.json is used when a variable is unset.

# ---- Minecraft target ----
MC_HOST=thelegions.aternos.me
MC_PORT=62129
MC_VERSION=1.20.1
MC_USERNAME=FREDDYGOAT
MC_AUTH=offline
# MC_PASSWORD=            # only for type: microsoft
AUTH_PASSWORD=            # /login + /register password used by auto-auth

# ---- Render keep-alive ----
# 1 = self-ping the public URL every KEEP_ALIVE_INTERVAL_MS (default 5 min, max 14 min)
KEEP_ALIVE=1
KEEP_ALIVE_INTERVAL_MS=300000
# Override the ping target (defaults to RENDER_EXTERNAL_URL, set by Render)
# KEEP_ALIVE_URL=https://your-service.onrender.com/ping

# ---- Safety ----
MEMORY_LIMIT_MB=460
# MC_DEBUG=1              # show raw protocol stack traces in the logs
